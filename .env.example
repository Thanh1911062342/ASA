#!/usr/bin/env bash
# Vercel KHÔNG có file .env: build chạy trên máy họ, không đọc máy bạn.
# UI (Vercel + Cloudflare) tự cấp secret; file này chỉ cần khi chạy `vercel dev`.
#
# Đổi `cors_origins` trong backend/.env thành domain Vercel của bạn, ví dụ:
#   CORS_ORIGINS=https://asa.vercel.app,http://localhost:5173
#
# Biến dưới đây KHÔNG bắt buộc: vì `/api` được Vercel rewrite (server-to-server),
# trình duyệt không bao giờ gọi thẳng backend nên CORS không được kiểm tra.
# Chỉ điền `VITE_API_BASE` nếu bạn chọn phương án "FE gọi thẳng backend" trong README.
VITE_API_BASE=